#!/bin/bash
# Pre-commit hook: chạy security checks trước khi commit

echo "Running security checks..."

# 1. git-secrets scan (skip gracefully nếu chưa cài)
if git secrets --version > /dev/null 2>&1; then
    git secrets --pre_commit_hook -- "$@"
    if [ $? -ne 0 ]; then
        echo "git-secrets found potential secrets! Commit blocked."
        exit 1
    fi
else
    echo "WARN: git-secrets not installed, skipping (install via brew/apt for full check)"
fi

# 2. Bandit SAST scan
if command -v bandit > /dev/null 2>&1; then
    echo "Running Bandit SAST..."
    bandit -r src/ -ll -q
    if [ $? -ne 0 ]; then
        echo "Bandit found security issues! Review above."
        exit 1
    fi
else
    echo "WARN: bandit not installed, skipping"
fi

# 3. pip-audit dependency check
if command -v pip-audit > /dev/null 2>&1; then
    echo "Checking dependencies for CVEs..."
    pip-audit --desc on
    if [ $? -ne 0 ]; then
        echo "WARN: Vulnerable dependencies found! Update before committing."
        exit 1
    fi
else
    echo "WARN: pip-audit not installed, skipping"
fi

echo "All security checks passed!"
exit 0
